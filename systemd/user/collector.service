# Collector. Runs on every machine that ACTUALLY runs Claude Code (e.g. cachyos).
# Exposes only /api/usage on :8788 over the Tailscale interface; the aggregator
# pulls from it. No files are synced.
#   cp deploy/collector.service ~/.config/systemd/user/
#   loginctl enable-linger "$USER"
#   systemctl --user enable --now collector
#
# Security: :8788 is reachable by anything that can route to this host. Rely on
# Tailscale ACLs, or bind to the Tailscale IP only: --bind 100.x.y.z
[Unit]
Description=AI usage collector (local ccusage -> JSON)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/Projects/dashboard
Environment=PATH=%h/.npm-global/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 server.py --collector --port 8788
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
