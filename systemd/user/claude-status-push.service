[Unit]
Description=push this machine's Claude activity snapshot to the dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/claude-status --push

Slice=background.slice
OOMScoreAdjust=700
MemoryMax=256M
CPUWeight=20
IOWeight=20
Nice=15
TimeoutStartSec=90
SuccessExitStatus=0 1
