[Unit]
Description=periodic Claude activity push to the dashboard

[Timer]
OnStartupSec=45s
OnUnitActiveSec=60s
# The dashboard treats a snapshot older than 180s as stale, so a 60s cadence
# survives two missed pushes before the tab starts reporting this machine quiet.
AccuracySec=10s

[Install]
WantedBy=timers.target
