[Unit]
Description=Watch Catapult CDDA/BN installs for re-extraction; repair lib symlinks and the BN cursor patch

[Path]
# Fires whenever Catapult writes into the game's lib dir (e.g. on update),
# and re-arms if the dir is deleted/recreated during a fresh install.
PathModified=/opt/catapult-bin/dda/game0/lib
PathChanged=/opt/catapult-bin/dda/game0/lib
PathModified=/opt/catapult-bin/bn/game0/lib
PathChanged=/opt/catapult-bin/bn/game0/lib
PathChanged=/opt/catapult-bin/bn/game0/data/mods/overhaul/overhaul_interface_tiles.json

[Install]
WantedBy=default.target
