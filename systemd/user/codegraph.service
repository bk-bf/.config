[Unit]
Description=codegraph viewer (Fantasia4x call-graph explorer)
Documentation=http://localhost:5185
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/kirill/Documents/local/Projects/codegraph
Environment=CI=true
# Low priority so it always yields CPU to whatever you're profiling. The viewer
# is idle most of the time; this only matters during an on-demand rebuild.
Nice=10
CPUWeight=30
# Build the graph once if it's missing so the viewer isn't empty (leading "-" =
# don't fail startup if it errors). Otherwise the graph is rebuilt only on demand
# via the viewer's header refresh button — there is no file watcher.
ExecStartPre=-/bin/sh -c 'test -f data/Fantasia4x.json || /usr/bin/node bin/codegraph.mjs extract Fantasia4x'
ExecStart=/usr/bin/node node_modules/vite/bin/vite.js dev --port 5185 --strictPort
Restart=on-failure
RestartSec=3
# A plain SIGTERM is how systemd itself stops this, and how anything sweeping up stray `vite dev`
# processes will end it. Without this, every ordinary stop is journalled as
# "Failed with result 'exit-code'" (status=143 = 128+15), which buries a real failure in noise.
SuccessExitStatus=143 SIGTERM

[Install]
WantedBy=default.target
