[Unit]
Description=Surface journal failures as noctalia notifications
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/home/kirill/.config/hypr/scripts/journal-notify.sh
Restart=on-failure
RestartSec=10

OOMScoreAdjust=0
MemoryMax=128M
CPUWeight=10
Nice=10

[Install]
WantedBy=graphical-session.target
