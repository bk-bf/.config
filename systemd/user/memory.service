# Memory UI. Runs on the machine whose ~/.claude/projects you want to read —
# the memory files are local, so this has to be local too. Bound to loopback:
# the tailnet interface drops inbound on the laptops anyway, and these files
# are the most personal thing on the disk.
#   cp deploy/memory.service ~/.config/systemd/user/
#   systemctl --user enable --now memory
#   → http://localhost:8790/memory
[Unit]
Description=Memory UI (browse/edit Claude Code memory silos)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/local/Projects/dashboard
Environment=PATH=%h/.npm-global/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 server.py --port 8790 --bind 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
