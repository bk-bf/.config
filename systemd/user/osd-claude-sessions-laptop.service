[Unit]
Description=osd scheduled sync — claude-sessions-laptop
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin
ExecStart=/home/kirill/Documents/local/Projects/osd/osd --guarded-sync claude-sessions-laptop

# Hardening: see osd-documents-remote.service. OOMScoreAdjust is the key line —
# the kernel reaps this long before it reaches the compositor.
OOMScoreAdjust=800
MemoryHigh=512M
MemoryMax=1G
CPUWeight=20
IOWeight=20
Nice=15
TimeoutStartSec=3600
