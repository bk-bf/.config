[Unit]
Description=Run the nightshift harvester periodically + before suspend

[Timer]
# a little after login, then every 15 min while awake. Harvesting is free (git
# diffs only — synth is what spends), so a tight cadence keeps dashboard "▶ run"
# requests responsive without cost.
OnStartupSec=2min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
