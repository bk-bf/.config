# Fix Samsung Galaxy Book4 Pro battery not detected on boot without AC adapter.
#
# Root cause: the EC firmware delays reporting BAT1 until a PMC/UCSI handshake
# completes. On AC-less boot this takes ~3-8s, by which time acpi_battery has
# already finished its probe pass. BAT1 never appears in /sys/class/power_supply/.
#
# Fix: wait 8s then force ACPI battery driver to bind the BAT1 device manually.
# ACPI path confirmed for Galaxy Book4 Pro (NP940XGK): \_SB_.PC00.LPCB.H_EC.BAT1
#
# Upstream patch under review (kernel bugzilla #218234, lore.kernel.org Feb 2025).
# Remove this service once the fix lands in cachyos-galaxybook-kernel.
#
# Source-controlled at ~/.config/systemd/fix-samsung-battery.service
# Install: sudo cp ~/.config/systemd/fix-samsung-battery.service \
#               /etc/systemd/system/fix-samsung-battery.service
#          sudo systemctl enable fix-samsung-battery.service

[Unit]
Description=Fix Samsung Galaxy Book battery detection on battery-only boot
DefaultDependencies=no
After=systemd-udev-settle.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/fix-samsung-battery.sh

[Install]
WantedBy=multi-user.target
