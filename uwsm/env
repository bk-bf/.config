export BROWSER=firefox
export TERM=xterm-kitty
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="qt6ct"
export ELECTRON_OZONE_PLATFORM_HINT=auto
# Adwaita ships only as an Xcursor theme (no hyprcursor variant installed), so
# HYPRCURSOR_THEME is intentionally left unset — with it set to a missing theme
# Hyprland falls back to its built-in default cursor. Leaving it unset makes
# Hyprland use the Xcursor below. (Bibata-Modern-Ice does have a hyprcursor if
# you ever want the native path back.)
export XCURSOR_THEME="Adwaita"
export XCURSOR_SIZE=24

# Force the legacy hyprland.conf (this repo) instead of the CachyOS default Lua config.
export HYPRLAND_CONFIG="$HOME/.config/hypr/hyprland.conf"
