# copilot steering — local only
.github/

# ── Default-deny: new top-level directories are ignored unless whitelisted ──
# To track a new directory, add !/<dirname>/ to the whitelist below.
/*/

# Symlinks to external repos — explicitly ignored so git doesn't track the
# symlink object and later remove it on branch switches / git restore.
/nvim-tdl
/nvim
# Host-specific symlink → ~/.local/share/pkglist/hosts/<host>/pkglist.txt
/pkglist.txt

# App-generated junk at repo root (Qt file-dialog history, electron update cache)
/QtProject.conf
/electron-builder.json

# Whitelisted top-level directories
!/.githooks/
!/.vscode/
!/Code/
!/.custom-kernel/
!/autostart/
!/btop/
!/cachyos/
!/crossnote/
!/.docs/
!/fish/
!/gnome-builder/
!/grub/
!/gtk-3.0/
!/gtk-4.0/
!/bin/
!/hypr/
!/hyprflow/
!/intel-undervolt/
!/kitty/
!/lazygit/
!/limine/
!/mpv/
!/noctalia/
# nvim/ — now lives in tdl repo, symlinked from ~/.config/nvim
!/nvim-treemux/
!/osync/
!/pamac/
!/qt6ct/
!/s2idle/
!/scripts/
!/sddm/
!/sioyek/
!/systemd/
!/tmux/
!/uwsm/
!/xdg-desktop-portal/
!/xsettingsd/

# Track only the bg-job worktree guard; the rest of .claude/ is runtime state
!/.claude/
/.claude/*
!/.claude/settings.json

# Track only config.toml; the rest of herdr/ is sockets, logs and session state
!/herdr/
/herdr/*
!/herdr/config.toml

