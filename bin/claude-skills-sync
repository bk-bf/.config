#!/usr/bin/env bash
# Skills are per-machine. A background session on ubuntuserver only has what is
# in its own ~/.claude/skills, so a prompt naming a skill that lives only on the
# laptop fails there — which is exactly how /fix ran without revertible-change.
#
# Only the portable ones. hyprland, noctalia, zen-browser, herdr and visual-dev
# are about a desktop the server does not have, and shipping them would invite
# an agent to reach for hyprctl on a headless box. Never --delete the whole
# directory: the server has skills of its own (notify, offload, sideagent,
# upscale) that are not mirrored from here.
set -euo pipefail

PORTABLE=(revertible-change orchestrator implement fork handoff branch-work debugging)
HOSTS=(ubuntu)
SRC="$HOME/.claude/skills"

for host in "${HOSTS[@]}"; do
  for s in "${PORTABLE[@]}"; do
    [ -d "$SRC/$s" ] || continue
    rsync -aL --delete -e 'ssh -o BatchMode=yes -o ConnectTimeout=10' \
      "$SRC/$s/" "$host:.claude/skills/$s/"
  done
  echo "skills synced to $host: ${PORTABLE[*]}"
done
