#!/usr/bin/env python3
"""Generate the index of universal memories that CLAUDE.md imports.

The shared set (~/memory-universal) is synced between machines and shown on the
dashboard, but nothing ever put it in front of an agent — 113 notes, read by
nobody. This is the delivery step.

An INDEX, not the notes themselves. 113 full notes in every session on every
machine is a large context bill for something mostly irrelevant to the task at
hand; a name and a one-line description each is ~11 KB, and the agent reads any
note in full the moment it looks relevant. Same trick MEMORY.md already uses.

Written by claude-memory-sync on its existing 5-minute timer. No new schedule.
"""
import re
import sys
from pathlib import Path

SRC = Path.home() / "memory-universal"
OUT = Path.home() / ".claude" / "universal-memories.md"

FM = re.compile(r"^---\s*\n(.*?)\n---\s*\n", re.S)


def field(front: str, key: str) -> str:
    m = re.search(rf"^{key}:\s*(.+?)\s*$", front, re.M)
    if not m:
        return ""
    return m.group(1).strip().strip('"').strip("'")


def main() -> int:
    if not SRC.is_dir():
        return 0
    rows = []
    for f in sorted(SRC.glob("*.md")):
        text = f.read_text(errors="replace")
        m = FM.match(text)
        front = m.group(1) if m else ""
        name = field(front, "name") or f.stem
        desc = field(front, "description")
        if not desc:                      # fall back to the first real line of prose
            body = text[m.end():] if m else text
            for line in body.splitlines():
                line = line.strip()
                if line and not line.startswith("#"):
                    desc = line[:160]
                    break
        # Capped: this file is imported into EVERY session on every machine, so
        # each extra 100 chars is paid ~113 times over. Enough to decide whether
        # to open the note, no more — the note itself is one read away.
        desc = " ".join(desc.split())
        if len(desc) > 130:
            desc = desc[:127].rstrip(" ,;–—-") + "…"
        rows.append((name, desc, f.name))

    out = [
        "# Universal memories",
        "",
        f"{len(rows)} notes that apply on every machine, kept in sync across them.",
        "",
        "**This is an index, not the memories.** Each line is a name, a one-line",
        "summary, and a filename. When a line looks relevant to what you are doing,",
        f"READ THE FULL NOTE at `{SRC}/<filename>` before acting — the summary is only",
        "enough to decide whether to open it, and acting on the summary alone will",
        "get the details wrong.",
        "",
        "Generated file: edit the notes themselves, never this.",
        "",
    ]
    out += [f"- **{n}** — {d} `{fn}`" for n, d, fn in rows]
    new = "\n".join(out) + "\n"

    OUT.parent.mkdir(parents=True, exist_ok=True)
    if OUT.exists() and OUT.read_text(errors="replace") == new:
        return 0
    OUT.write_text(new)
    print(f"universal-memories index: {len(rows)} notes -> {OUT}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
