#!/bin/bash

set -euo pipefail

RAPL=${POWER_AUTO_RAPL:-/sys/class/powercap/intel-rapl:0}
PROFILE_FILE=${POWER_AUTO_PROFILE_FILE:-/sys/firmware/acpi/platform_profile}
BATTERY=${POWER_AUTO_BATTERY:-/sys/class/power_supply/BAT1}
AC_ONLINE=${POWER_AUTO_AC_ONLINE:-/sys/class/power_supply/ADP1/online}
BACKLIGHT=${POWER_AUTO_BACKLIGHT:-/sys/class/backlight/intel_backlight}
LID_STATE=${POWER_AUTO_LID_STATE:-/proc/acpi/button/lid/LID0/state}
SUSPEND_STATS=${POWER_AUTO_SUSPEND_STATS:-/sys/power/suspend_stats}
WAKEUP_IRQ=${POWER_AUTO_WAKEUP_IRQ:-/sys/power/pm_wakeup_irq}
DRY_RUN=${POWER_AUTO_DRY_RUN:-0}
UP_MW=$(( ${POWER_AUTO_UP_W:-14} * 1000 ))
UP_WINDOW_S=${POWER_AUTO_UP_WINDOW_S:-20}
DOWN_MW=$(( ${POWER_AUTO_DOWN_W:-12} * 1000 ))
DOWN_WINDOW_S=${POWER_AUTO_DOWN_WINDOW_S:-120}
MIN_PERFORMANCE_S=${POWER_AUTO_MIN_PERFORMANCE_S:-180}
MIN_BALANCED_S=${POWER_AUTO_MIN_BALANCED_S:-60}
SAVER_BATTERY_BELOW_PCT=${POWER_AUTO_SAVER_BATTERY_BELOW_PCT:-30}
SAVER_BRIGHTNESS_BELOW_PCT=${POWER_AUTO_SAVER_BRIGHTNESS_BELOW_PCT:-50}
LID_POLL_S=${POWER_AUTO_LID_POLL_S:-5}
REASSERT_AFTER_RESUME_S=${POWER_AUTO_REASSERT_AFTER_RESUME_S:-60}
STATUS_EVERY_S=${POWER_AUTO_STATUS_EVERY_S:-600}
RESUME_GAP_MS=5000

declare -A PL1_UW=([performance]=28000000 [balanced]=15000000)
declare -A PL2_UW=([performance]=45000000 [balanced]=25000000)
declare -A PPD_NAME=([low-power]=power-saver [balanced]=balanced [performance]=performance)

log() { printf '%s\n' "$*"; }

now_ms() {
    local t=${EPOCHREALTIME/,/.}
    echo $(( ${t%.*} * 1000 + 10#${t#*.} / 1000 ))
}

limits_key() {
    if [[ $1 == performance ]]; then echo performance; else echo balanced; fi
}

current_limits() {
    echo "$(<"$RAPL/constraint_0_power_limit_uw") $(<"$RAPL/constraint_1_power_limit_uw")"
}

foreign=""

assert_limits() {
    local key
    key=$(limits_key "$1")
    if [[ $(current_limits) != "${PL1_UW[$key]} ${PL2_UW[$key]}" ]]; then
        echo "${PL1_UW[$key]}" > "$RAPL/constraint_0_power_limit_uw"
        echo "${PL2_UW[$key]}" > "$RAPL/constraint_1_power_limit_uw"
        log "limits for $1: PL1 $(( PL1_UW[$key] / 1000000 )) W, PL2 $(( PL2_UW[$key] / 1000000 )) W"
    fi
    foreign=""
}

watch_limits() {
    local key have pl1 pl2
    key=$(limits_key "$1")
    have=$(current_limits)
    if [[ $have != "${PL1_UW[$key]} ${PL2_UW[$key]}" && $have != "$foreign" ]]; then
        foreign=$have
        read -r pl1 pl2 <<<"$have"
        log "limits changed outside power-auto in $1: PL1 $(( pl1 / 1000000 )) W, PL2 $(( pl2 / 1000000 )) W"
    fi
}

set_profile() {
    if [[ $DRY_RUN == 1 ]]; then
        echo "$1" > "$PROFILE_FILE"
    else
        powerprofilesctl set "${PPD_NAME[$1]}"
    fi
}

ac=1
capacity=100
brightness=100
rest=balanced

read_power_source() {
    local now max
    ac=1
    capacity=100
    brightness=100
    [[ -r $AC_ONLINE ]] && ac=$(<"$AC_ONLINE")
    [[ -r $BATTERY/capacity ]] && capacity=$(<"$BATTERY/capacity")
    if [[ -r $BACKLIGHT/brightness && -r $BACKLIGHT/max_brightness ]]; then
        now=$(<"$BACKLIGHT/brightness")
        max=$(<"$BACKLIGHT/max_brightness")
        (( max > 0 )) && brightness=$(( now * 100 / max ))
    fi
    if [[ $ac == 0 ]] && (( capacity < SAVER_BATTERY_BELOW_PCT )) || (( brightness < SAVER_BRIGHTNESS_BELOW_PCT )); then
        rest=low-power
    else
        rest=balanced
    fi
}

lid_is_closed() {
    [[ -r $LID_STATE && $(<"$LID_STATE") == *closed* ]]
}

lid_switch_state() {
    python3 - <<'LIDPY' 2>/dev/null || echo unknown
import fcntl, array, glob, os
EVIOCGSW = (2 << 30) | (8 << 16) | (0x45 << 8) | 0x1b
for dev in sorted(glob.glob('/dev/input/event*')):
    try:
        name = open('/sys/class/input/%s/device/name' % os.path.basename(dev)).read().strip()
    except OSError:
        continue
    if name != 'Lid Switch':
        continue
    buf = array.array('B', [0] * 8)
    try:
        with open(dev, 'rb') as fd:
            fcntl.ioctl(fd, EVIOCGSW, buf, True)
    except OSError:
        print('unknown')
        break
    print('closed' if buf[0] & 1 else 'open')
    break
else:
    print('unknown')
LIDPY
}

lid_state_text() {
    local acpi=unknown
    [[ -r $LID_STATE ]] && acpi=$(awk '{print $2}' "$LID_STATE")
    echo "acpi=$acpi switch=$(lid_switch_state)"
}

logind_prop() {
    busctl get-property org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager "$1" 2>/dev/null \
        | sed -E 's/^[a-z] "?([^"]*)"?$/\1/' || true
}

PMC=${POWER_AUTO_PMC:-/sys/kernel/debug/pmc_core}

s0ix_usec() {
    cat "$PMC/slp_s0_residency_usec" 2>/dev/null || echo ""
}

unmet_substates() {
    awk -F'|' '
        NR == 1 {
            for (i = 1; i <= NF; i++) { h = $i; gsub(/ /, "", h); if (h == "Status") col = i }
            next
        }
        col == 0 { next }
        {
            elem = $1; sub(/^[^:]*: */, "", elem); gsub(/ /, "", elem)
            required = 0
            for (i = 2; i < col; i++) if ($i ~ /Required/) required = 1
            status = $col; gsub(/ /, "", status)
            if (required && status == "" && elem != "") out = out (out ? "," : "") elem
        }
        END { print out }' "$PMC/substate_requirements" 2>/dev/null | cut -c1-300
}

substate_residency() {
    awk 'NR > 1 && $1 ~ /^S0i/ { printf "%s %s\n", $1, $2 }' "$PMC/substate_residencies" 2>/dev/null
}

substate_delta() {
    { printf '%s\n' "$1"; echo '--'; substate_residency; } | awk -v ms="$2" '
        $1 == "--" { second = 1; next }
        !second { was[$1] = $2; next }
        { d = ($2 - was[$1]) / 10 / ms; if (d > 0) printf "%s:%d%% ", $1, d }
        END { printf "\n" }'
}

awake_devices() {
    local d out=""
    for d in /sys/bus/pci/devices/*/power/runtime_status /sys/bus/usb/devices/*/power/runtime_status /sys/bus/i2c/devices/*/power/runtime_status; do
        [[ -r $d ]] || continue
        [[ $(<"$d") == active ]] || continue
        out="$out${out:+,}$(basename "$(dirname "$(dirname "$d")")")"
    done
    printf '%s' "${out:0:300}"
}

charge_mah() {
    local v
    v=$(cat "$BATTERY/charge_now" 2>/dev/null) || v=""
    [[ $v =~ ^[0-9]+$ ]] && echo $(( v / 1000 )) || echo ""
}

voltage_uv() {
    cat "$BATTERY/voltage_now" 2>/dev/null || echo ""
}

wake_counts() {
    local w name count
    for w in /sys/class/wakeup/wakeup*; do
        [[ -r $w/name && -r $w/event_count ]] || continue
        name=$(<"$w/name")
        count=$(<"$w/event_count")
        printf '%s %s\n' "$name" "$count"
    done
}

wake_delta() {
    { printf '%s\n' "$1"; echo '--'; wake_counts; } | awk '
        $1 == "--" { second = 1; next }
        !second { was[$1] = $2; next }
        { d = $2 - was[$1]; if (d > 0) printf "%s +%d ", $1, d }
        END { printf "\n" }'
}

sleep_report() {
    local slept_ms=$1 before=$2 hw_us irq name="" drain="" hw="unknown" mah_now v s0ix_now s0ix_pct="unknown" drain_w="unknown" mah_drop
    hw_us=$(cat "$SUSPEND_STATS/last_hw_sleep" 2>/dev/null) || hw_us=""
    irq=$(cat "$WAKEUP_IRQ" 2>/dev/null) || irq=""
    [[ -n $irq ]] && name=$(awk -v i="$irq:" '$1 == i {print $NF}' /proc/interrupts)
    [[ $hw_us =~ ^[0-9]+$ ]] && hw="$(( hw_us / 10 / slept_ms )) %"
    if (( before >= capacity && slept_ms > 0 )); then
        drain=$(( (before - capacity) * 36000000 / slept_ms ))
        drain=", $(( drain / 10 )).$(( drain % 10 )) %/h"
    fi
    mah_now=$(charge_mah)
    v=$(voltage_uv)
    s0ix_now=$(s0ix_usec)
    if [[ $s0ix_now =~ ^[0-9]+$ && $s0ix_before =~ ^[0-9]+$ ]]; then
        s0ix_pct=$(( (s0ix_now - s0ix_before) / 10 / slept_ms ))
    fi
    if [[ $mah_now =~ ^[0-9]+$ && $mah_before =~ ^[0-9]+$ && $v =~ ^[0-9]+$ ]] && (( mah_before >= mah_now && slept_ms > 0 )); then
        mah_drop=$(( mah_before - mah_now ))
        drain_w=$(( mah_drop * (v / 1000) * 360 / slept_ms ))
        drain_w="$(( drain_w / 100 )).$(( drain_w % 100 ))"
    fi
    log "slept $(( slept_ms / 60000 )) min $(( slept_ms / 1000 % 60 )) s, battery ${before} % -> ${capacity} %${drain}, hardware sleep ${hw}, woken by IRQ ${irq:-unknown} ${name}"
    awake_s=0
    awake_mah=""
    if (( last_resume_t > 0 )); then
        awake_s=$(( (t - last_resume_t) / 1000 - slept_ms / 1000 ))
        if [[ $last_resume_mah =~ ^[0-9]+$ && $mah_before =~ ^[0-9]+$ ]]; then
            awake_mah=$(( last_resume_mah - mah_before ))
        fi
    fi
    log "sleep-report slept_s=$(( slept_ms / 1000 )) wake_irq=${irq:-unknown} wake_name=${name:-unknown} batt_before=${before} batt_after=${capacity} mah_before=${mah_before:-unknown} mah_after=${mah_now:-unknown} drain_w=${drain_w} hw_sleep_pct=${hw% *} s0ix_pct=${s0ix_pct} wake_sources=[$(wake_delta "$wake_before")] unmet_substates=[$(unmet_substates)] awake_devices=[${awake_before}] substates=[$(substate_delta "$substate_before" "$slept_ms")] awake_s_before=${awake_s} awake_mah_before=${awake_mah:-unknown}"
    last_resume_t=$t
    last_resume_mah=$(charge_mah)
}

samples=()

mean_last() {
    local n=$1 c=${#samples[@]} s=0 i
    if (( c < n )); then
        echo -1
        return
    fi
    for (( i = c - n; i < c; i++ )); do
        s=$(( s + samples[i] ))
    done
    echo $(( s / n ))
}

mean_text() {
    local m
    m=$(mean_last "$1")
    if (( m < 0 )); then echo "no data"; else echo "$(( m / 1000 )) W"; fi
}

keep=$(( UP_WINDOW_S > DOWN_WINDOW_S ? UP_WINDOW_S : DOWN_WINDOW_S ))
max_range=$(<"$RAPL/max_energy_range_uj")
prev_e=$(<"$RAPL/energy_uj")
prev_t=$(now_ms)
seen=$(<"$PROFILE_FILE")
switched_at=$prev_t
status_at=$prev_t
reassert_at=$(( prev_t + REASSERT_AFTER_RESUME_S * 1000 ))
resting=""
lid_closed=0
lid_checked_at=0
wake_checked_at=0
wake_before=$(wake_counts)
mah_before=$(charge_mah)
s0ix_before=$(s0ix_usec)
substate_before=$(substate_residency)
awake_before=$(awake_devices)
last_resume_t=0
last_resume_mah=""

read_power_source
log "up at $(( UP_MW / 1000 )) W over ${UP_WINDOW_S} s, down under $(( DOWN_MW / 1000 )) W over ${DOWN_WINDOW_S} s, power-saver under ${SAVER_BATTERY_BELOW_PCT} % battery on battery or under ${SAVER_BRIGHTNESS_BELOW_PCT} % brightness, profile $seen"
assert_limits "$seen"

while sleep 1; do
    e=$(<"$RAPL/energy_uj")
    t=$(now_ms)
    d=$(( e - prev_e ))
    (( d < 0 )) && d=$(( d + max_range ))
    dt=$(( t - prev_t ))
    prev_e=$e
    prev_t=$t
    (( dt > 0 )) || continue
    profile=$(<"$PROFILE_FILE")
    if (( dt > RESUME_GAP_MS )); then
        before=$capacity
        read_power_source
        log "resumed after ${dt} ms in $profile"
        log "wake sources during sleep: $(wake_delta "$wake_before")"
        sleep_report "$dt" "$before"
        samples=()
        assert_limits "$profile"
        reassert_at=$(( t + REASSERT_AFTER_RESUME_S * 1000 ))
        continue
    fi
    samples+=("$(( d / dt ))")
    (( ${#samples[@]} > keep )) && samples=("${samples[@]:1}")
    if [[ $profile != "$seen" ]]; then
        log "profile changed outside power-auto: $seen -> $profile"
        seen=$profile
        switched_at=$t
        assert_limits "$profile"
    fi
    read_power_source
    if [[ $rest != "$resting" ]]; then
        if [[ ($profile == balanced || $profile == low-power) && $profile != "$rest" ]]; then
            set_profile "$rest"
            profile=$rest
            seen=$rest
            switched_at=$t
            log "$rest: battery ${capacity} %, AC online $ac, brightness ${brightness} %"
            assert_limits "$rest"
        fi
        resting=$rest
    fi
    if (( t - wake_checked_at >= 10000 )); then
        wake_checked_at=$t
        wake_before=$(wake_counts)
        mah_before=$(charge_mah)
        s0ix_before=$(s0ix_usec)
        substate_before=$(substate_residency)
        awake_before=$(awake_devices)
    fi
    if (( t - lid_checked_at >= LID_POLL_S * 1000 )); then
        lid_checked_at=$t
        if lid_is_closed; then
            if (( lid_closed == 0 )); then
                lid_closed=1
                log "lid closed, battery ${capacity} %, AC online $ac, switch $(lid_switch_state)"
            fi
        elif (( lid_closed == 1 )); then
            lid_closed=0
            log "lid open"
        fi
    fi
    if (( reassert_at > 0 && t >= reassert_at )); then
        reassert_at=0
        assert_limits "$profile"
    fi
    watch_limits "$profile"
    since=$(( (t - switched_at) / 1000 ))
    if (( t - status_at >= STATUS_EVERY_S * 1000 )); then
        status_at=$t
        log "status: $profile for ${since} s, resting $resting, battery ${capacity} %, AC online $ac, brightness ${brightness} %, lid $(lid_state_text), ${UP_WINDOW_S} s mean $(mean_text "$UP_WINDOW_S"), ${DOWN_WINDOW_S} s mean $(mean_text "$DOWN_WINDOW_S")"
    fi
    if [[ $profile == balanced || $profile == low-power ]] && (( since >= MIN_BALANCED_S )); then
        up=$(mean_last "$UP_WINDOW_S")
        if (( up >= UP_MW )); then
            set_profile performance
            seen=performance
            switched_at=$t
            log "performance: package held $(( up / 1000 )) W for ${UP_WINDOW_S} s"
            assert_limits performance
        fi
    elif [[ $profile == performance ]] && (( since >= MIN_PERFORMANCE_S )); then
        down=$(mean_last "$DOWN_WINDOW_S")
        if (( down >= 0 && down < DOWN_MW )); then
            set_profile "$resting"
            seen=$resting
            switched_at=$t
            log "$resting: package under $(( DOWN_MW / 1000 )) W for ${DOWN_WINDOW_S} s"
            assert_limits "$resting"
        fi
    fi
done
