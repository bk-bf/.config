{
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "editor.formatOnSave": true,
  "code-runner.runInTerminal": true,
  "code-runner.executorMap": {
    "javascript": "node",
    "java": "cd $dir && javac $fileName && java $fileNameWithoutExt",
    "c": "cd $dir && gcc $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
    "zig": "zig run",
    "cpp": "cd $dir && g++ $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
    "objective-c": "cd $dir && gcc -framework Cocoa $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
    "php": "php",
    "python": "clear && python3 -u",
    "perl": "perl",
    "perl6": "perl6",
    "ruby": "ruby",
    "go": "go run",
    "lua": "lua",
    "groovy": "groovy",
    "powershell": "powershell -ExecutionPolicy ByPass -File",
    "bat": "cmd /c",
    "shellscript": "bash",
    "fsharp": "fsi",
    "csharp": "scriptcs",
    "vbscript": "cscript //Nologo",
    "typescript": "ts-node",
    "coffeescript": "coffee",
    "scala": "scala",
    "swift": "swift",
    "julia": "julia",
    "crystal": "crystal",
    "ocaml": "ocaml",
    "r": "Rscript",
    "applescript": "osascript",
    "clojure": "lein exec",
    "haxe": "haxe --cwd $dirWithoutTrailingSlash --run $fileNameWithoutExt",
    "rust": "cd $dir && rustc $fileName && $dir$fileNameWithoutExt",
    "racket": "racket",
    "scheme": "csi -script",
    "ahk": "autohotkey",
    "autoit": "autoit3",
    "dart": "dart",
    "pascal": "cd $dir && fpc $fileName && $dir$fileNameWithoutExt",
    "d": "cd $dir && dmd $fileName && $dir$fileNameWithoutExt",
    "haskell": "runghc",
    "nim": "nim compile --verbosity:0 --hints:off --run",
    "lisp": "sbcl --script",
    "kit": "kitc --run",
    "v": "v run",
    "sass": "sass --style expanded",
    "scss": "scss --style expanded",
    "less": "cd $dir && lessc $fileName $fileNameWithoutExt.css",
    "FortranFreeForm": "cd $dir && gfortran $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
    "fortran-modern": "cd $dir && gfortran $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
    "fortran_fixed-form": "cd $dir && gfortran $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
    "fortran": "cd $dir && gfortran $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
    "sml": "cd $dir && sml $fileName",
  },
  "workbench.iconTheme": "vscode-icons",
  "security.workspace.trust.untrustedFiles": "open",
  "cmake.showOptionsMovedNotification": false,
  "cmake.pinnedCommands": [
    "workbench.action.tasks.configureTaskRunner",
    "workbench.action.tasks.runTask",
  ],
  "cmake.showConfigureWithDebuggerNotification": false,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.lineHeight": 1.6,
  "workbench.editor.splitInGroupLayout": "vertical",
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.editor.enablePreviewFromCodeNavigation": false,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 10,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.limit.excludeDirty": true,
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/objects/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.debug/**": true,
    "**/target/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.debug": true
  },
  "typescript.tsserver.maxTsServerMemory": 3072,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.ignoredRepositories": ["/home/kirill/.config/ffssb"],
  "opencodego.customBaseUrl": "https://openrouter.ai/api/v1",
  "opencodego.commitModel": "deepseek-v4-pro",
  "javascript.updateImportsOnFileMove.enabled": "never",
  "svelte.enable-ts-plugin": true,
  "gitlens.ai.largePromptWarningThreshold": 100000,
  "gitdoc.filePattern": "**/*.md",
  "github.copilot.nextEditSuggestions.enabled": true,
  "chat.editing.confirmEditRequestRemoval": false,
  "copilotPremiumUsageMonitor.selectedPlanId": "copilot-proplus",
  "copilotPremiumUsageMonitor.budget": 100,
  "copilotPremiumUsageMonitor.disableFirstRunTips": true,
  "sonarlint.connectedMode.connections.sonarcloud": [],
  "workbench.startupEditor": "none",
  "terminal.integrated.automationProfile.linux": {},
  "terminal.integrated.defaultProfile.osx": "bash",
  "chat.tools.terminal.autoApprove": {
    "/^wc -l scripts/\\*\\*/\\*\\.gd scenes/\\*\\*/\\*\\.gd 2>/dev/null \\| awk '\\$1 < 200 \\{count\\+\\+\\} END \\{print count\\}'$/": {
      "approve": true,
      "matchCommandLine": true,
    },
    "/^wc -l scripts/\\*\\*/\\*\\.gd scenes/\\*\\*/\\*\\.gd 2>/dev/null \\| awk '\\$1 >= 200 && \\$1 < 500 \\{count\\+\\+\\} END \\{print count\\}'$/": {
      "approve": true,
      "matchCommandLine": true,
    },
    "/^wc -l scripts/\\*\\*/\\*\\.gd scenes/\\*\\*/\\*\\.gd 2>/dev/null \\| awk '\\$1 >= 500 && \\$1 < 1000 \\{count\\+\\+\\} END \\{print count\\}'$/": {
      "approve": true,
      "matchCommandLine": true,
    },
    "/^wc -l scripts/\\*\\*/\\*\\.gd scenes/\\*\\*/\\*\\.gd 2>/dev/null \\| awk '\\$1 >= 1000 \\{count\\+\\+\\} END \\{print count\\}'$/": {
      "approve": true,
      "matchCommandLine": true,
    },
    "/^wc -l scripts/\\*\\*/\\*\\.gd scenes/\\*\\*/\\*\\.gd 2>/dev/null \\| sort -rn \\| awk 'NR <= 107 && \\$1 != \"total\" \\{if \\(\\$1 > 1500\\) crit\\+\\+; else if \\(\\$1 >= 1000\\) large\\+\\+; else if \\(\\$1 >= 500\\) ok\\+\\+; else if \\(\\$1 >= 200\\) good\\+\\+; else exc\\+\\+\\} END \\{print \"Excellent \\(<200\\):\", exc; print \"Good \\(200-500\\):\", good; print \"OK \\(500-1000\\):\", ok; print \"Large \\(1000-1500\\):\", large; print \"Critical \\(>1500\\):\", crit\\}'$/": {
      "approve": true,
      "matchCommandLine": true,
    },
    "/^awk '/\\^func /\\{in_func=1; complexity=1\\} in_func && /\\\\tif \\|for \\|while \\|match /\\{complexity\\+\\+\\} in_func && /\\^func / && NR>1\\{if\\(complexity>15\\) print prev_func \" - Complexity: \" complexity\\} in_func\\{prev_func=\\$0\\} /\\^\\[\\^ \\\\t\\]/ && !/\\^func /\\{in_func=0\\}' scripts/\\*\\*/\\*\\.gd 2>/dev/null \\| head -20$/": {
      "approve": true,
      "matchCommandLine": true,
    },
    "awk": true,
    "timeout": true,
    "/^python3 -c \"import json; json\\.load\\(open\\('data/conditions\\.json'\\)\\)\" && echo \"✅ conditions\\.json is valid JSON\"$/": {
      "approve": true,
      "matchCommandLine": true,
    },
    "/Applications/Godot.app/Contents/MacOS/Godot": true,
    "sed": true,
    "mv": true,
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "projectManager.sortList": "Recent",
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
  },
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "/usr/bin/bash",
    },
    "zsh": {
      "path": "zsh",
    },
    "fish": {
      "path": "fish",
    },
    "tPARALLEL": {
      "path": "tPARALLEL",
      "icon": "terminal-tPARALLEL",
    },
    "pwsh": {
      "path": "pwsh",
      "icon": "terminal-powershell",
    },
  },
  "workbench.colorTheme": "August - Drawbridge (Darker)",
  "copilotPremiumUsageMonitor.token": "",
  "chat.editing.confirmEditRequestRetry": false,
  "python.defaultInterpreterPath": "/bin/python",
  "editor.fontFamily": "'Droid Sans Mono', monospace, MesloLGL Nerd Font",
  "explorer.confirmPasteNative": false,
  "markdown-preview-enhanced.hideDefaultVSCodeMarkdownPreviewButtons": false,
  "explorer.excludeGitIgnore": true,
  "terminal.integrated.initialHint": false,
  "python.analysis.typeCheckingMode": "strict",
  "chat.tips.enabled": false,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[markdown]": {
    // Hand-authored specs with manually aligned tables — never auto-format (Prettier
    // reflows tables/prose and fights the layout). Format by hand if ever needed.
    "editor.formatOnSave": false,
  },
  "chat.planAgent.defaultModel": "Claude Sonnet 4.6 (copilot)",
  "chat.editor.wordWrap": "on",
  "chat.restoreLastPanelSession": true,
  "chat.viewProgressBadge.enabled": true,
  "chat.tools.autoApprove": true,
  "workbench.settings.applyToAllProfiles": [
    "chat.viewSessions.orientation",
    "workbench.editor.enablePreview",
    "workbench.editor.enablePreviewFromQuickOpen",
    "workbench.editor.enablePreviewFromCodeNavigation",
  ],
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
    "*.qrc": "qt-core.qrcEditor",
  },
  "qt-core.additionalQtPaths": [
    {
      "name": "Qt-5.15.18-linux-g++_from_PATH",
      "path": "/usr/bin/qmake",
    },
  ],
  "github.copilot.chat.rateLimitAutoSwitchToAuto": true,
  "chat.viewSessions.orientation": "stacked",
  "diffEditor.maxComputationTime": 0,
  "editor.minimap.enabled": false,
  "extensions.ignoreRecommendations": true,
  "claudeCode.initialPermissionMode": "bypassPermissions",
  "claudeCode.allowDangerouslySkipPermissions": true,
  "opencodego.commitIncludeCommitDiff": true,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "chat.unifiedAgentsBar.enabled": true,
  "workbench.browser.showInTitleBar": true,
  "ai-commit.AI_COMMIT_SYSTEM_PROMPT": "Given these staged changes:{changes}Generate a commit message that follows these rules:1. Start with a type (feat/fix/docs)2. Keep it under 200 characters3. Use imperative mood, add bulletpoints",
  "ai-commit.OPENAI_MODEL": "moonshot-v1-auto",
  "ai-commit.AI_PROVIDER": "openai",
  "ai-commit.OPENAI_BASE_URL": "https://api.moonshot.ai/v1",
  "ai-commit.OPENAI_API_TYPE": "completion",
  "ai-commit.OPENAI_TEMPERATURE": 0.3,
  "editor.definitionLinkOpensInPeek": true,
  "window.openFilesInNewWindow": "on",
  "workbench.experimental.modernUI": false,
}
